<launch>
    <arg name="robot_type" />
    <arg name="gui" default="true" />

    <include file="$(find gazebo_sim)/launch/iris_with_roscam2.launch">
        <arg name="gui" value="$(arg gui)" />
        <arg name="rviz" value="false" />
        <arg name="robot_type" value="$(arg robot_type)" />
        <arg name="output" value="log" />
    </include>
    <test pkg="dankong" type="test_waypoint_event.py" test-name="test_waypoint_event" time-limit="600">
        <param name="robot_type" value="$(arg robot_type)" />
    </test>

    <include file="$(find gazebo_sim)/launch/apm.launch">
        <arg name="fcu_url" value="tcp://:5760@" />
        <arg name="respawn_mavros" value="true" />
    </include>
    <node pkg="dankong" name="dankong_node" type="dankong_$(arg robot_type)_node" respawn="true" output="screen">
    </node>
</launch>
