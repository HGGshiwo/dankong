<launch>
    <arg name="robot_type" default="drone"/>
    <arg name="config" default="$(find dankong)/config/$(arg robot_type)-config.yaml"/>
    <arg name="debug" default="false" />
    
    <node pkg="dankong" name="dankong" type="dankong_$(arg robot_type)_node" args="--config $(arg config)" output="screen" />
    <include file="$(find pland_controller)/launch/pland_controller.launch">
    </include>

    <include file="$(find pland_detector)/launch/pland_detector.launch">
    </include>
</launch>